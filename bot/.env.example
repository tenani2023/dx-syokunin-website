# このファイルを .env にコピーして値を入れる。.env は git に入れない。
# VPS(163.44.110.129)では /srv/dx-syokunin-website/bot/.env

# LINE Messaging API(LINE Developers > チャネル > Messaging API設定)
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# 投稿を許可するLINEのユーザーID(カンマ区切り)。空のままだと、話しかけた人にIDを返すだけで投稿はしない
ALLOWED_USER_IDS=

# OpenAI(文章: Responses API / 画像: gpt-image)
OPENAI_API_KEY=
# 文章生成モデルと推論の深さ(low / medium / high)
OPENAI_TEXT_MODEL=gpt-5.5
OPENAI_REASONING_EFFORT=high
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_QUALITY=medium
# 1記事あたりの本文画像の上限(見出しごとに1枚。ヒーロー画像は別に1枚)
MAX_SECTION_IMAGES=6

# サイトのリポジトリ(VPS上にcloneしたパス)。git push できる状態にしておく
REPO_DIR=/srv/dx-syokunin-website
GIT_BRANCH=main
GIT_AUTHOR_NAME=dx-syokunin-bot
GIT_AUTHOR_EMAIL=bot@senwa-inc.com

# GitHub の Webhook(push されたら VPS のサイトを再生成)。リポジトリ > Settings > Webhooks に
# Payload URL https://dx-syokunin.jp/deploy、Content type application/json、Secret にこの値を入れる
DEPLOY_SECRET=

# Google 連携(任意。無くても動くが、候補の精度が上がる)
# サービスアカウントのJSON鍵のパス(例: /srv/dx-syokunin-website/bot/google-key.json)
GOOGLE_APPLICATION_CREDENTIALS=
# Search Console のプロパティ(ドメインプロパティなら sc-domain:dx-syokunin.jp、URLプレフィックスなら https://dx-syokunin.jp/)
GSC_SITE_URL=sc-domain:dx-syokunin.jp
# GA4 のプロパティID(数字のみ。管理 > プロパティ設定 に表示)
GA4_PROPERTY_ID=
# 記録用スプレッドシートのID(URLの /d/ と /edit の間)。サービスアカウントに編集者で共有しておく
SHEET_ID=
# 定期提案(cron 形式・日本時間)。例: 毎週月曜 8:00 → "0 8 * * 1"。空なら提案しない
SUGGEST_CRON=0 8 * * 1

# サーバー(nginx が /webhook と /deploy をこのポートへ渡す)
PORT=3200

# 手元のPCで試すときは 1 にする(git の同期・commit・push をしない。VPSでは必ず空にする)
LOCAL_MODE=
