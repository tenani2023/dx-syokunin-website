[Unit]
Description=DX職人 コラム投稿ボット(LINE)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bot
WorkingDirectory=/srv/dx-syokunin-website/bot
EnvironmentFile=/srv/dx-syokunin-website/bot/.env
ExecStart=/usr/bin/node src/index.mjs
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
